# Caddyfile — Automatic HTTPS reverse proxy for Burma Duta API
#
# Replace 'api.burmaduta.com' with your actual domain.
# Caddy will automatically obtain and renew TLS certificates via Let's Encrypt.
#
# For local development without a domain, use:
#   :80 {
#       reverse_proxy api:8081
#   }

api.burmaduta.com {
    # Reverse proxy to the internal API container
    reverse_proxy api:8081

    # Security headers
    header {
        # Prevent MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking protection
        X-Frame-Options "DENY"
        # XSS protection (legacy browsers)
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server identification
        -Server
    }

    # Access logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
