# 🗄️ DATABASE (Supabase)
INTERNAL_STORE_URI=postgresql://postgres:password@db_host:5432/postgres

# 🛡️ API SECURITY (CORS)
# REQUIRED: Set your exact frontend domain(s). Do NOT use wildcard '*' in production.
ALLOWED_ORIGINS=https://example.com,https://example.pages.dev

# 🔑 API AUTHENTICATION
# REQUIRED: Set a secret key for backend API access
API_KEY=your_sample_secret_api_key_123
