# 🗄️ DATABASE (Supabase)
INTERNAL_STORE_URI=postgresql://postgres:password@db_host:5432/postgres

# 🛡️ API SECURITY (CORS)
# REQUIRED: exact frontend origin(s), comma separated. Scheme included, no
# trailing slash. '*' is rejected at start-up; it cannot be combined with
# credentialed requests.
ALLOWED_ORIGINS=https://example.com,https://example.pages.dev

# 🔑 API AUTHENTICATION
# REQUIRED: at least 16 characters. The API refuses to start if this is unset or
# left as the placeholder below. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_sample_secret_api_key_123

# 🌐 API NETWORK EXPOSURE
# Host interface the API port is published on. Keep 127.0.0.1 so only the
# reverse proxy can reach it — ufw does NOT filter Docker-published ports.
# Set to 0.0.0.0 only to temporarily revert; that exposes the API publicly.
API_BIND_HOST=127.0.0.1

# Peers whose X-Forwarded-For header uvicorn will trust (the rate limiter keys
# on it). '*' is safe only while API_BIND_HOST=127.0.0.1. If you narrow this,
# use the address the CONTAINER observes — with a host-side proxy that is the
# Docker bridge gateway (e.g. 172.17.0.1), not 127.0.0.1. Setting it wrong
# collapses every user into one rate-limit bucket.
TRUSTED_PROXY_IPS=*

# 🧲 SEMANTIC DE-DUPLICATION
# Cosine-similarity cutoff above which two same-township reports within 24h are
# treated as one incident. Scoring above it discards the later report, so err
# high when unsure. Calibrate against real data before changing:
#   docker compose exec api python backend/calibrate_dedup.py
DEDUP_SIMILARITY_THRESHOLD=0.85

# 🔮 FORECAST SCHEDULER
# OPTIONAL: Runs Prophet in-process at 03:00 SGT. Off by default because model
# fitting is memory hungry; confirm the host has headroom before enabling.
FORECAST_SCHEDULER_ENABLED=false
